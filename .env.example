# ── Database ──────────────────────────────────────────────
POSTGRES_USER=bi_admin
POSTGRES_PASSWORD=bi_admin_dev
POSTGRES_DB=bi_copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Read-only role used for AI-generated queries
BI_READER_USER=bi_reader
BI_READER_PASSWORD=bi_reader_dev

# ── Security ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI ────────────────────────────────────────────────────
# LLM_PROVIDER: none | anthropic | openai
# "none" enables Demo Mode (deterministic rule engine — no API key needed)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# ── Limits / uploads ──────────────────────────────────────
QUERY_TIMEOUT_SECONDS=10
QUERY_ROW_LIMIT=5000
MAX_UPLOAD_SIZE_MB=50

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
